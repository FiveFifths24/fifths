# Supabase Project Settings > API. These browser-safe values become required in Phase 2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secrets must never use NEXT_PUBLIC_. Add them only when a server feature needs them.
# SUPABASE_SERVICE_ROLE_KEY=add-to-vercel-only-when-required

# Canonical application URL (local development shown).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
