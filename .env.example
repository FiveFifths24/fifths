# Supabase Project Settings > API. These browser-safe values are required for Phase 2 account flows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Phase 10 does not require a service-role key. Never add one to browser code.

# Canonical application URL (local development shown).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
