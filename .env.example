# Supabase Project Settings > API. These browser-safe values are required for Phase 2 account flows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required only on the server for private image quarantine and publication.
# Supabase Project Settings > API > service_role. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Image moderation. Production fails closed unless one provider is configured.
# Recommended initial provider: azure. A normalized webhook adapter is also
# available for specialist or multi-vendor moderation services.
IMAGE_MODERATION_PROVIDER=azure
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=your-azure-content-safety-key

# Alternative provider contract (HTTPS only):
# IMAGE_MODERATION_PROVIDER=webhook
# IMAGE_MODERATION_WEBHOOK_URL=https://moderation.example.com/v1/images
# IMAGE_MODERATION_WEBHOOK_TOKEN=your-secret-bearer-token

# Local development only. This value is rejected when NODE_ENV=production.
# IMAGE_MODERATION_PROVIDER=development-allow

# Protects the quarantine cleanup endpoint used by a scheduled job.
CRON_SECRET=replace-with-a-long-random-secret

# Canonical application URL (local development shown).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
